{
  "mcpServers": {
    "noizu-google": {
      "command": "mix",
      "args": ["run", "--no-halt"],
      "cwd": "REPLACE_WITH_ABS_PATH/elixir-google-mcp",
      "env": {
        "GOOGLE_ACCESS_TOKEN": "from-session-or-refresh",
        "GOOGLE_REFRESH_TOKEN": "",
        "GOOGLE_CLIENT_ID": "",
        "GOOGLE_CLIENT_SECRET": "",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": ""
      }
    }
  }
}
